exports[`WordSyncedLyricsLine > (Snapshot) renders ruby, background vocals, and annotations 1`] = `
<div>
  <button
    class="font-lyrics rtl:font-lyrics-arabic hover:text-foreground block w-full cursor-pointer py-1 text-start tracking-tight transition-colors duration-100 rtl:tracking-normal text-foreground"
    data-active="true"
    data-testid="lyrics-line"
    dir="auto"
    type="button"
  >
    <span
      class="block"
    >
      <span
        class="before:bg-primary relative isolate before:absolute before:-start-px before:bottom-0 before:-z-10 before:h-[0.1em] before:w-(--fill-width)"
        data-active="true"
        data-testid="lyrics-word"
        style="--fill-width: calc((100% + 1px) * 1);"
      >
        <ruby
          data-testid="lyrics-ruby"
        >
          <span
            data-testid="lyrics-ruby-text"
          >
            夜
          </span>
          <rt
            class="font-sans font-normal"
            data-testid="lyrics-ruby-reading"
          >
            よる
          </rt>
        </ruby>
      </span>
      <span
        class="before:bg-primary relative isolate before:absolute before:-start-px before:bottom-0 before:-z-10 before:h-[0.1em] before:w-(--fill-width)"
        data-active="true"
        data-testid="lyrics-word"
        style="--fill-width: calc((100% + 1px) * 0.5);"
      >
        に
      </span>
      <span
        class="before:bg-primary relative isolate before:absolute before:-start-px before:bottom-0 before:-z-10 before:h-[0.1em] before:w-(--fill-width)"
        data-active="false"
        data-testid="lyrics-word"
        style="--fill-width: calc((100% + 1px) * 0);"
      >
        <ruby
          data-testid="lyrics-ruby"
        >
          <span
            data-testid="lyrics-ruby-text"
          >
            駆
          </span>
          <rt
            class="font-sans font-normal"
            data-testid="lyrics-ruby-reading"
          >
            か
          </rt>
        </ruby>
      </span>
      <span
        class="before:bg-primary relative isolate before:absolute before:-start-px before:bottom-0 before:-z-10 before:h-[0.1em] before:w-(--fill-width)"
        data-active="false"
        data-testid="lyrics-word"
        style="--fill-width: calc((100% + 1px) * 0);"
      >
        ける
      </span>
      <span
        class="font-semibold italic opacity-60"
        data-testid="lyrics-background-vocals"
      >
         (
        Lorem ipsum
        )
      </span>
    </span>
    <span
      class="rtl:font-lyrics-arabic block text-start font-sans text-base font-normal tracking-normal opacity-60"
      data-testid="lyrics-annotation"
      data-type="romanization"
      dir="auto"
      lang="ja-Latn"
    >
      Yoru ni kakeru
    </span>
    <span
      class="rtl:font-lyrics-arabic block text-start font-sans text-base font-normal tracking-normal opacity-60"
      data-testid="lyrics-annotation"
      data-type="translation"
      dir="auto"
      lang="en"
    >
      Racing into the night
    </span>
  </button>
</div>
`;
