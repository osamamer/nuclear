// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`WordSyncedLyricsLine > (Snapshot) renders a line halfway through its second word 1`] = `
<div>
  <button
    class="font-lyrics rtl:font-lyrics-arabic hover:text-foreground block w-full cursor-pointer py-1 text-start tracking-tight transition-colors duration-100 rtl:tracking-normal text-foreground"
    data-active="true"
    data-testid="lyrics-line"
    dir="auto"
    type="button"
  >
    <span
      class="block"
    >
      <span
        class="before:bg-primary relative isolate before:absolute before:-start-px before:bottom-0 before:-z-10 before:h-[0.1em] before:w-(--fill-width)"
        data-active="true"
        data-testid="lyrics-word"
        style="--fill-width: calc((100% + 1px) * 1);"
      >
        Lorem 
      </span>
      <span
        class="before:bg-primary relative isolate before:absolute before:-start-px before:bottom-0 before:-z-10 before:h-[0.1em] before:w-(--fill-width)"
        data-active="true"
        data-testid="lyrics-word"
        style="--fill-width: calc((100% + 1px) * 0.5);"
      >
        ipsum 
      </span>
      <span
        class="before:bg-primary relative isolate before:absolute before:-start-px before:bottom-0 before:-z-10 before:h-[0.1em] before:w-(--fill-width)"
        data-active="false"
        data-testid="lyrics-word"
        style="--fill-width: calc((100% + 1px) * 0);"
      >
        dolor
      </span>
    </span>
  </button>
</div>
`;

exports[`WordSyncedLyricsLine > (Snapshot) renders a line that has already played 1`] = `
<div>
  <button
    class="font-lyrics rtl:font-lyrics-arabic hover:text-foreground block w-full cursor-pointer py-1 text-start tracking-tight transition-colors duration-100 rtl:tracking-normal text-foreground/40"
    data-active="false"
    data-testid="lyrics-line"
    dir="auto"
    type="button"
  >
    <span
      class="block"
    >
      Lorem 
      ipsum 
      dolor
    </span>
  </button>
</div>
`;

