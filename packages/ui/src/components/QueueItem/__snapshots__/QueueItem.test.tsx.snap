exports[`QueueItem > (Snapshot) renders current state 1`] = `
<div
  class="group group relative flex items-center gap-3 overflow-hidden rounded-lg border border-transparent transition-colors bg-primary/10 h-14 w-full px-2 py-1.5"
  data-is-current="true"
  data-testid="queue-item"
  role="button"
>
  <div
    class="bg-muted relative flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-md"
    data-testid="queue-item-thumbnail"
  >
    <img
      alt="Bohemian Rhapsody"
      class="h-full w-full object-cover"
      src="https://picsum.photos/seed/queen/300"
    />
    <div
      class="absolute inset-0 flex items-center justify-center bg-black/45 text-white"
      data-testid="queue-item-playing-indicator"
    >
      <span
        aria-hidden="true"
        class="inline-flex items-end h-4 gap-[3px]"
        data-paused="false"
        data-testid="moving-equalizer"
      >
        <span
          class="animate-eq-bar h-full origin-bottom rounded-full bg-current w-[3px]"
          data-testid="moving-equalizer-bar"
          style="animation-delay: -0.45s;"
        />
        <span
          class="animate-eq-bar h-full origin-bottom rounded-full bg-current w-[3px]"
          data-testid="moving-equalizer-bar"
          style="animation-delay: -0.15s;"
        />
        <span
          class="animate-eq-bar h-full origin-bottom rounded-full bg-current w-[3px]"
          data-testid="moving-equalizer-bar"
          style="animation-delay: -0.6s;"
        />
        <span
          class="animate-eq-bar h-full origin-bottom rounded-full bg-current w-[3px]"
          data-testid="moving-equalizer-bar"
          style="animation-delay: -0.3s;"
        />
      </span>
    </div>
  </div>
  <div
    class="min-w-0 flex-1"
  >
    <div
      class="truncate text-sm leading-5 font-semibold"
      data-testid="queue-item-title"
    >
      Bohemian Rhapsody
    </div>
    <div
      class="text-foreground/60 truncate text-xs"
      data-testid="queue-item-artist"
    >
      Queen
    </div>
  </div>
  <div
    class="relative flex shrink-0 items-center justify-start"
  >
    <div
      class="text-foreground/55 mr-3 text-xs tabular-nums"
      data-testid="queue-item-duration"
    >
      5:54
    </div>
    <button
      aria-label="Remove from queue"
      class="data-selected:bg-primary/10 data-selected:text-primary inline-flex cursor-pointer items-center rounded-md whitespace-nowrap transition-colors outline-none disabled:cursor-not-allowed disabled:opacity-50 text-foreground hover:bg-primary/10 size-8 justify-center absolute right-2 opacity-0 group-hover:opacity-100"
      data-headlessui-state=""
      data-testid="queue-item-remove-button"
      type="button"
    >
      <svg
        aria-hidden="true"
        class="lucide lucide-x"
        fill="none"
        height="16"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="16"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M18 6 6 18"
        />
        <path
          d="m6 6 12 12"
        />
      </svg>
    </button>
  </div>
</div>
`;

